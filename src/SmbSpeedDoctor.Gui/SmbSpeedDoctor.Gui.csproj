<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Allows WinForms cross-build from Linux (SDK resolves Windows targeting packs) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>SmbSpeedDoctor.Gui</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Authors>forg3</Authors>
    <Company>forg3</Company>
    <Description>SMB Speed Doctor - GUI application for SMB bottleneck diagnosis</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmbSpeedDoctor.Core\SmbSpeedDoctor.Core.csproj" />
    <ProjectReference Include="..\SmbSpeedDoctor.Core.Windows\SmbSpeedDoctor.Core.Windows.csproj" />
  </ItemGroup>

</Project>
