<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows-dependent collection (WMI via System.Management, performance
    counters, SMB client config). Separated from SmbSpeedDoctor.Core so that the
    pure domain — model, diagnostic engine, and baseline — remains
    net8.0 and free of any platform-specific APIs.

    Previously everything resided in Core with TargetFramework net8.0, generating
    42 CA1416 warnings ("supported only on Windows") and promising nonexistent
    portability. This project is the honest place for this code.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>SmbSpeedDoctor.Core.Windows</RootNamespace>
    <!-- Allows compiling on Linux; execution still requires Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Authors>forg3</Authors>
    <Company>forg3</Company>
    <Description>SMB Speed Doctor - Windows collector library</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmbSpeedDoctor.Core\SmbSpeedDoctor.Core.csproj" />
  </ItemGroup>

</Project>
